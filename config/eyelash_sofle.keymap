#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mmv {
    time-to-max-speed-ms = <200>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        /* Left-hand HRMs (GUI/Alt/Ctrl) */
        /* Right-hand HRMs (Ctrl/Alt/GUI) */

        hrm_L: hrm_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 38 46 47 48 49 50 59 60 61 55 56 57 26>;
        };

        hrm_R: hrm_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 26 27 28 29 30 31 41 42 43 44 40 57 56 55 38 59 60 61>;
            hold-trigger-on-release;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <250>;
        };

        mod_num: mod_num {
            compatible = "zmk,behavior-tap-dance";
            label = "MOD_NUM";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&tog 1>;

            tapping-term-ms = <200>;
        };

        mod_symfunc: mod_symfunc {
            compatible = "zmk,behavior-tap-dance";
            label = "MOD_SYMFUNC";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;

            tapping-term-ms = <200>;
        };

        hrm_ctrl_L: hrm_ctrl_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 38 46 47 48 49 50 59 60 61 55 56 57 26>;
        };

        hrm_ctrl_R: hrm_ctrl_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 26 27 28 29 30 31 41 42 43 44 40 57 56 55 38 59 60 61>;
            hold-trigger-on-release;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        /* Shift variants (shorter tapping term for quick capitalization) */
    };

    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 42>;
            layers = <0>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 43>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <14 15>;
            layers = <0>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <24 23>;
            layers = <0>;
        };

        page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <16 17>;
            layers = <1>;
        };

        page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <29 30>;
            layers = <1>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <15 16>;
            layers = <1>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <28 29>;
            layers = <1>;
        };
    };

    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "BRACKET_SOFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&trans      &trans               &trans             &trans                        &trans                      &trans      &trans  &trans         &trans                       &trans              &trans              &trans                        &trans
&trans      &kp Q                &kp W              &kp E                         &kp R                       &kp T       &trans  &kp Y          &kp U                        &kp I               &kp O               &kp P                         &trans
&kp ESCAPE  &hrm_L LEFT_SHIFT A  &hrm_L LEFT_GUI S  &hrm_L LEFT_ALT D             &hrm_ctrl_L LEFT_CONTROL F  &kp G       &trans  &kp H          &hrm_ctrl_R RIGHT_CONTROL J  &hrm_R RIGHT_ALT K  &hrm_R RIGHT_GUI L  &hrm_R RIGHT_SHIFT SEMICOLON  &kp ENTER
&trans      &kp Z                &kp X              &kp C                         &kp V                       &kp B       &trans  &kp N          &kp M                        &kp COMMA           &kp DOT             &kp FSLH                      &trans
&kp C_MUTE  &trans               &trans             &hrm_ctrl_R LEFT_CONTROL TAB  &kp LEFT_SHIFT              &mod_num    &trans  &kp BACKSPACE  &kp SPACE                    &mod_symfunc        &trans              &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "default";
        };

        numpad_arrow {
            bindings = <
&trans            &trans            &trans         &trans             &trans           &trans       &trans  &trans         &trans  &trans  &trans  &trans             &trans
&trans            &kp PRINTSCREEN   &bracket_soft  &kp UP_ARROW       &kp PLUS         &kp MINUS    &trans  &kp GRAVE      &kp N7  &kp N8  &kp N9  &kp DOUBLE_QUOTES  &trans
&kp LEFT_CONTROL  &kp C_PLAY_PAUSE  &kp LEFT       &kp DOWN           &kp RIGHT        &kp STAR     &trans  &kp BACKSLASH  &kp N4  &kp N5  &kp N6  &kp SQT            &trans
&trans            &kp C_PREVIOUS    &kp C_NEXT     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp SLASH    &trans  &trans         &kp N1  &kp N2  &kp N3  &kp EQUAL          &trans
&trans            &trans            &trans         &trans             &trans           &trans       &trans  &trans         &kp N0  &trans  &trans  &trans
            >;

            label = "npad/arrow";
        };

        symbols_functions {
            bindings = <
&trans            &trans           &trans     &trans         &trans      &trans                  &trans  &trans                 &trans    &trans    &trans     &trans   &trans
&trans            &kp PERCENT      &kp CARET  &kp AMPERSAND  &kp ASTRK   &kp LEFT_BRACKET        &trans  &kp RIGHT_BRACKET      &kp F9    &kp UP    &kp F10    &kp F11  &trans
&kp LEFT_CONTROL  &kp EXCLAMATION  &kp AT     &kp HASH       &kp DOLLAR  &kp LEFT_PARENTHESIS    &trans  &kp RIGHT_PARENTHESIS  &kp LEFT  &kp DOWN  &kp RIGHT  &kp F12  &trans
&trans            &kp F1           &kp F2     &kp F3         &kp F4      &kp LEFT_BRACE          &trans  &kp RIGHT_BRACE        &kp F5    &kp F6    &kp F7     &kp F8   &trans
&trans            &trans           &trans     &trans         &trans      &trans                  &trans  &trans                 &trans    &trans    &trans     &trans
            >;

            label = "sym/fnc";
        };

        system {
            bindings = <
&trans  &trans          &trans        &trans        &trans        &trans    &trans  &trans  &trans           &trans           &trans                            &trans           &trans
&trans  &bt BT_SEL 3    &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans    &trans  &trans  &trans           &trans           &rgb_ug RGB_BRD                   &rgb_ug RGB_BRI  &trans
&trans  &bt BT_SEL 4    &trans        &out OUT_USB  &out OUT_BLE  &trans    &trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &rgb_ug RGB_EFR                   &rgb_ug RGB_EFF  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &bt BT_CLR    &trans    &trans  &trans  &trans           &rgb_ug RGB_SAD  &rgb_ug RGB_COLOR_HSB(10,100,50)  &rgb_ug RGB_SAI  &trans
&trans  &trans          &trans        &trans        &trans        &trans    &trans  &trans  &trans           &trans           &trans                            &trans
            >;

            label = "system";
        };

        navigation_mouse {
            bindings = <
&trans  &trans            &trans          &trans         &trans     &trans        &trans  &trans           &trans          &trans          &trans           &trans  &trans
&trans  &kp LC(LS(N))     &kp LC(N)       &kp LC(LS(T))  &kp LC(T)  &trans        &trans  &msc SCRL_LEFT   &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LALT       &kp TAB    &kp LA(F4)    &trans  &msc SCRL_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LC(Z)         &kp LC(X)       &kp LC(C)      &kp LC(V)  &kp LC(Y)     &trans  &trans           &trans          &trans          &trans           &trans  &trans
&trans  &trans            &trans          &trans         &trans     &trans        &trans  &mkp LCLK        &mkp RCLK       &mkp MCLK       &trans           &trans
            >;

            label = "bw/msc";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
