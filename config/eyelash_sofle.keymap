#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mmv {
    time-to-max-speed-ms = <200>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        /* Left-hand HRMs (GUI/Alt/Ctrl) */
        /* Right-hand HRMs (Ctrl/Alt/GUI) */

        hrm_L: hrm_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 46 47 48 49 50 59 60 56 57>;
        };

        hrm_R: hrm_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 27 28 29 30 31 41 42 43 44 40 57 56 59 60>;
            hold-trigger-on-release;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <250>;
        };

        mod_num: mod_num {
            compatible = "zmk,behavior-tap-dance";
            label = "MOD_NUM";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&tog 1>;

            tapping-term-ms = <200>;
        };

        hrm_ctrl_L: hrm_ctrl_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 46 47 48 49 50 59 60 56 57>;
        };

        hrm_ctrl_R: hrm_ctrl_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 27 28 29 30 31 41 42 43 44 40 57 56 59 60>;
            hold-trigger-on-release;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        z_ctrl: z_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <41 42 43 44 31 18 17 16 28 29 30>;
        };

        tab_layer1: tab_layer1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_LAYER1";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        enter_: enter_ {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
        };

        /* Shift variants (shorter tapping term for quick capitalization) */
    };

    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 42>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 43>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <14 15>;
            layers = <1>;
        };

        page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <17 30>;
            layers = <1>;
        };

        page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <30 43>;
            layers = <1>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <40 41>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        parentheses_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        parentheses_2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };

        bracket_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 34>;
            layers = <1>;
        };

        bracket_2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 35>;
            layers = <1>;
        };

        brace_1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <34 47>;
            layers = <1>;
        };

        brace_2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <35 48>;
            layers = <1>;
        };

        cond_sys_layer {
            bindings = <&mo 2>;
            key-positions = <57 59>;
            layers = <0 2>;
            require-prior-idle-ms = <300>;
            slow-release;
        };
    };

    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "BRACKET_SOFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&trans  &trans                  &trans             &trans               &trans                      &trans               &trans  &trans         &trans                       &trans                &trans              &trans                      &trans
&trans  &kp Q                   &kp W              &kp E                &kp R                       &kp T                &trans  &kp Y          &kp U                        &kp I                 &kp O               &kp P                       &trans
&trans  &hrm_L LEFT_GUI A       &hrm_L LEFT_ALT S  &hrm_L LEFT_SHIFT D  &hrm_ctrl_L LEFT_CONTROL F  &kp G                &trans  &kp H          &hrm_ctrl_R RIGHT_CONTROL J  &hrm_R RIGHT_SHIFT K  &hrm_R RIGHT_ALT L  &hrm_R RIGHT_GUI SEMICOLON  &trans
&trans  &z_ctrl LEFT_CONTROL Z  &kp X              &kp C                &kp V                       &kp B                &trans  &kp N          &kp M                        &kp COMMA             &kp DOT             &kp ENTER                   &trans
&trans  &trans                  &trans             &trans               &kp LEFT_SHIFT              &tab_layer1 1 TAB    &trans  &kp BACKSPACE  &kp SPACE                    &trans                &trans              &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "default";
        };

        numpad_arrow {
            bindings = <
&trans  &trans        &trans           &trans        &trans           &trans        &trans  &trans         &trans                        &trans                 &trans               &trans                       &trans
&trans  &kp ESCAPE    &kp PRINTSCREEN  &kp UP_ARROW  &kp EXCLAMATION  &kp AT        &trans  &bracket_soft  &kp N7                        &kp N8                 &kp N9               &kp DOUBLE_QUOTES            &trans
&trans  &kp DELETE    &kp LEFT         &kp DOWN      &kp RIGHT        &kp HASH      &trans  &kp QUESTION   &hrm_ctrl_R RIGHT_CONTROL N4  &hrm_R RIGHT_SHIFT N5  &hrm_R RIGHT_ALT N6  &hrm_R RIGHT_GUI APOSTROPHE  &trans
&trans  &kp ASTERISK  &kp AMPERSAND    &kp CARET     &kp PERCENT      &kp DOLLAR    &trans  &trans         &kp N1                        &kp N2                 &kp N3               &kp SLASH                    &trans
&trans  &trans        &trans           &trans        &trans           &trans        &trans  &trans         &kp N0                        &trans                 &trans               &trans
            >;

            label = "numpad";
        };

        system {
            bindings = <
&trans  &trans   &trans   &trans    &trans     &trans       &trans  &trans            &trans             &trans           &trans        &trans          &trans
&trans  &kp F1   &kp F2   &kp F3    &kp F4     &kp F5       &trans  &bt BT_CLR        &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3    &trans
&trans  &kp F6   &kp F7   &kp F8    &kp F9     &kp F10      &trans  &kp C_PLAY_PAUSE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PREV    &kp C_NEXT      &trans
&trans  &kp F11  &kp F12  &kp C_PP  &kp TILDE  &kp GRAVE    &trans  &kp BACKSLASH     &kp PIPE           &rgb_ug RGB_TOG  &out OUT_TOG  &bt BT_CLR_ALL  &trans
&trans  &trans   &trans   &trans    &trans     &trans       &trans  &trans            &trans             &trans           &trans        &trans
            >;

            label = "system";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
