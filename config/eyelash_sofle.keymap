#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        /* Left-hand HRMs (GUI/Alt/Ctrl) */

        hml: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            /* Right-hand + center arrows + all thumbs */

            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>;
            hold-trigger-on-release;
        };

        /* Right-hand HRMs (Ctrl/Alt/GUI) */

        hmr: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            /* Left-hand + center arrows + all thumbs */

            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>;
            hold-trigger-on-release;
        };

        /* Shift variants (shorter tapping term for quick capitalization) */

        hsl: left_shift_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HSL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>;
            hold-trigger-on-release;
        };

        hsr: right_shift_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HSR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        bracket_soft {
            bindings = <&bracket_soft>;
            key-positions = <29 30>;
            layers = <1>;
        };

        bracket_quote {
            bindings = <&bracket_quote>;
            key-positions = <29 28>;
            layers = <1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
            layers = <0>;
        };

        apostrophe {
            bindings = <&kp SQT>;
            key-positions = <47 48>;
            layers = <0>;
        };

        tggle_numpad {
            bindings = <&tog 2>;
            key-positions = <61 35 34>;
            layers = <0 2>;
        };

        tggle_browser {
            bindings = <&tog 4>;
            key-positions = <29 55 30>;
            layers = <0 4>;
        };
    };

    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "BRACKET_SOFT";
        };

        bracket_square: bracket_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "BRACKET_SQUARE";
        };

        bracket_sqiggly: bracket_sqiggly {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "BRACKET_SQIGGLY";
        };

        bracket_quote: bracket_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT_ARROW>;
            label = "BRACKET_QUOTE";
        };

        bracket_triangle: bracket_triangle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT &kp LEFT>;
            label = "BRACKET_TRIANGLE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp CAPSLOCK      &kp N1  &kp N2           &kp N3           &kp N4               &kp N5    &kp UP_ARROW     &kp N6         &kp N7                &kp N8            &kp N9           &kp N0         &kp TILDE
&kp TAB           &kp Q   &kp W            &kp E            &kp R                &kp T     &kp DOWN_ARROW   &kp Y          &kp U                 &kp I             &kp O            &kp P          &kp DELETE
&kp LEFT_CONTROL  &kp A   &hml LEFT_GUI S  &hml LEFT_ALT D  &hml LEFT_CONTROL F  &kp G     &kp LEFT_ARROW   &kp H          &hmr RIGHT_CONTROL J  &hmr RIGHT_ALT K  &hmr LEFT_GUI L  &kp SEMICOLON  &kp ENTER
&kp ESCAPE        &kp Z   &kp X            &kp C            &kp V                &kp B     &kp RIGHT_ARROW  &kp N          &kp M                 &kp COMMA         &kp DOT          &kp FSLH       &tog 4
&kp C_MUTE        &none   &none            &mo 2            &kp LEFT_SHIFT       &mo 1     &kp ENTER        &kp BACKSPACE  &kp SPACE             &mo 3             &none            &none
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "default";
        };

        num_symbol {
            bindings = <
&trans  &trans           &trans           &trans     &trans      &trans         &trans  &trans     &trans         &trans        &trans                &trans                 &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN      &kp POUND  &kp DOLLAR  &kp PERCENT    &trans  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp N1           &kp N2           &kp N3     &kp N4      &kp N5         &trans  &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &trans
&trans  &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp LBKT   &kp RBKT    &trans         &trans  &trans     &kp MINUS      &kp PLUS      &kp EQUAL             &kp UNDER              &trans
&trans  &trans           &trans           &trans     &trans      &trans         &trans  &trans     &trans         &trans        &trans                &trans
            >;

            label = "numbers";
        };

        numpad_arrow {
            bindings = <
&trans        &trans     &trans    &trans        &trans         &trans             &trans  &trans      &trans  &trans  &trans  &trans  &trans
&kp LEFT_ALT  &kp TAB    &kp DEL   &kp UP_ARROW  &kp BACKSPACE  &trans             &trans  &kp EQUAL   &kp N7  &kp N8  &kp N9  &trans  &trans
&trans        &trans     &kp LEFT  &kp DOWN      &kp RIGHT      &trans             &trans  &kp PERIOD  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans        &kp SLASH  &kp STAR  &kp MINUS     &kp PLUS       &kp PRINTSCREEN    &trans  &kp N0      &kp N1  &kp N2  &kp N3  &trans  &trans
&trans        &trans     &trans    &trans        &trans         &trans             &trans  &trans      &trans  &trans  &trans  &trans
            >;

            label = "npad/arrow";
        };

        function {
            bindings = <
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &trans             &trans           &trans            &trans         &trans            &trans
&trans  &kp PAUSE_BREAK  &kp SCROLLLOCK  &trans  &kp PRINTSCREEN  &kp F11    &trans  &kp F12            &kp PIPE         &kp BACKSLASH     &kp TILDE      &kp GRAVE         &trans
&trans  &kp F1           &kp F2          &kp F3  &kp F4           &kp F5     &trans  &kp F6             &kp F7           &kp F8            &kp F9         &kp F10           &trans
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE  &kp C_AC_BACK  &kp C_AC_FORWARD  &trans
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &trans             &trans           &trans            &trans         &trans
            >;

            label = "f_keys";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        navigation_mouse {
            bindings = <
&trans  &trans            &trans          &trans         &trans     &trans        &trans  &trans          &trans          &trans          &trans           &trans  &trans
&trans  &kp LC(LS(N))     &kp LC(N)       &kp LC(LS(T))  &kp LC(T)  &trans        &trans  &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LALT       &kp TAB    &kp LA(F4)    &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LC(Z)         &kp LC(X)       &kp LC(C)      &kp LC(V)  &kp LC(Y)     &trans  &trans          &trans          &trans          &trans           &trans  &trans
&trans  &trans            &trans          &trans         &trans     &trans        &trans  &mkp LCLK       &mkp RCLK       &mkp MCLK       &trans           &trans
            >;

            label = "bw/msc";
        };

        system {
            bindings = <
&trans  &trans        &trans        &trans          &trans        &trans    &trans  &trans  &trans           &trans           &trans                            &trans           &trans
&trans  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &bt BT_SEL 0  &trans    &trans  &trans  &trans           &trans           &rgb_ug RGB_BRD                   &rgb_ug RGB_BRI  &trans
&trans  &trans        &trans        &out OUT_USB    &out OUT_BLE  &trans    &trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &rgb_ug RGB_EFR                   &rgb_ug RGB_EFF  &trans
&trans  &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR    &trans    &trans  &trans  &trans           &rgb_ug RGB_SAD  &rgb_ug RGB_COLOR_HSB(10,100,50)  &rgb_ug RGB_SAI  &trans
&trans  &trans        &trans        &trans          &trans        &trans    &trans  &trans  &trans           &trans           &trans                            &trans
            >;

            label = "system";
        };

        page_nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans       &trans         &trans    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans       &trans         &trans    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp PAGE_UP  &kp PAGE_DOWN  &kp HOME  &kp END  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans       &trans         &trans    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans       &trans         &trans    &trans
            >;

            label = "pagenav";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        page_nav {
            if-layers = <4 2>;
            then-layer = <6>;
        };

        system_layer {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };
};
