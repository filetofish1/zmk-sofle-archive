#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&mmv {
    time-to-max-speed-ms = <200>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        hrm_L: hrm_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-unless-interrupted";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 46 47 48 49 50 59 60 56 57>;
        };

        hrm_R: hrm_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 27 28 29 30 31 41 42 43 44 40 57 56 59 60>;
            hold-trigger-on-release;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
        };

        hrm_ctrl_L: hrm_ctrl_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 21 22 23 24 34 35 36 37 20 21 22 23 24 33 34 35 36 37 46 47 48 49 50 59 60 56 57>;
        };

        hrm_ctrl_R: hrm_ctrl_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <14 15 16 17 18 27 28 29 30 31 41 42 43 44 40 57 56 59 60>;
            hold-trigger-on-release;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        z_ctrl: z_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-unless-interrupted";
            hold-trigger-on-release;
            hold-trigger-key-positions = <31 18 17 16 28 29 30 44>;
        };

        tab_layer1: tab_layer1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_LAYER1";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <16 29 28 30 14 27 40 21 22 23 34 35 36 47 48 49 60>;
            hold-trigger-on-release;
        };

        bckspce_layer2: bckspce_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "BCKSPCE_LAYER2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <14 15 16 17 27 28 29 30 40 41 42 43 34 35 36 37>;
            hold-trigger-on-release;
        };

        /* Shift variants (shorter tapping term for quick capitalization) */
    };

    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        exlam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <15 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <16 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <17 30>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <18 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <20 33>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <21 34>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <22 35>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <23 36>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        parentheses_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        parentheses_2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        bracket_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 34>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        bracket_2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 35>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        brace_1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <34 47>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        brace_2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <35 48>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <40 41>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <40 42>;
            require-prior-idle-ms = <50>;
            layers = <0>;
            timeout-ms = <30>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 42>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 43>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <49 48>;
            require-prior-idle-ms = <50>;
            layers = <0>;
            timeout-ms = <18>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <48 47>;
            timeout-ms = <18>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <16 29>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <29 42>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        mute {
            bindings = <&kp C_MUTE>;
            key-positions = <15 17>;
            timeout-ms = <18>;
            require-prior-idle-ms = <50>;
            layers = <1>;
        };

        to_numpad {
            bindings = <&to 1>;
            key-positions = <27 40>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        from_numpad {
            bindings = <&to 0>;
            key-positions = <27 40>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1>;
        };

        to_system {
            bindings = <&to 2>;
            key-positions = <37 50>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        from_system {
            bindings = <&to 0>;
            key-positions = <37 50>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <2>;
        };
    };

    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "BRACKET_SOFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&trans  &trans               &trans             &trans             &trans                      &trans               &trans  &trans                       &trans                       &trans              &trans              &trans                        &trans
&trans  &kp Q                &kp W              &kp E              &kp R                       &kp T                &trans  &kp Y                        &kp U                        &kp I               &kp O               &kp P                         &trans
&trans  &hrm_L LEFT_SHIFT A  &hrm_L LEFT_GUI S  &hrm_L LEFT_ALT D  &hrm_ctrl_L LEFT_CONTROL F  &kp G                &trans  &kp H                        &hrm_ctrl_R RIGHT_CONTROL J  &hrm_R RIGHT_ALT K  &hrm_R RIGHT_GUI L  &hrm_R RIGHT_SHIFT SEMICOLON  &trans
&trans  &z_ctrl LCTRL Z      &kp X              &kp C              &kp V                       &kp B                &trans  &kp N                        &kp M                        &kp COMMA           &kp DOT             &kp SLASH                     &trans
&trans  &trans               &trans             &trans             &kp LEFT_SHIFT              &tab_layer1 1 TAB    &trans  &bckspce_layer2 2 BACKSPACE  &kp SPACE                    &trans              &trans              &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "default";
        };

        numpad_arrow {
            bindings = <
&trans  &trans                            &trans             &trans        &trans           &trans       &trans  &trans     &trans                        &trans               &trans               &trans                         &trans
&trans  &kp ESCAPE                        &kp C_VOLUME_DOWN  &kp UP_ARROW  &kp C_VOLUME_UP  &kp SLASH    &trans  &kp ASTRK  &kp N7                        &kp N8               &kp N9               &kp DOUBLE_QUOTES              &trans
&trans  &kp DELETE                        &kp LEFT           &kp DOWN      &kp RIGHT        &kp MINUS    &trans  &kp PLUS   &hrm_ctrl_R RIGHT_CONTROL N4  &hrm_R RIGHT_ALT N5  &hrm_R RIGHT_GUI N6  &hrm_R RIGHT_SHIFT APOSTROPHE  &trans
&trans  &z_ctrl LEFT_CONTROL PRINTSCREEN  &kp C_PREV         &kp C_PP      &kp C_NEXT       &kp DOT      &trans  &kp EQUAL  &kp N1                        &kp N2               &kp N3               &kp ENTER                      &trans
&trans  &trans                            &trans             &trans        &trans           &trans       &trans  &trans     &kp N0                        &trans               &trans               &trans
            >;

            label = "numpad";
        };

        system {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans          &trans  &trans         &trans             &trans           &trans         &trans           &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp CAPSLOCK    &trans  &bracket_soft  &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2   &bt BT_SEL 3     &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp GRAVE       &trans  &kp BACKSLASH  &kp RIGHT_CONTROL  &kp RIGHT_ALT    &kp RIGHT_GUI  &kp RIGHT_SHIFT  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp TILDE       &trans  &kp PIPE       &bt BT_CLR_ALL     &rgb_ug RGB_TOG  &out OUT_TOG   &bt BT_CLR_ALL   &trans
&trans  &trans  &trans   &trans   &trans   &trans          &trans  &trans         &trans             &trans           &trans         &trans
            >;

            label = "system";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
