#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 [cite: 183]
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25 [cite: 183]

#include <input/processors.dtsi> [cite: 183]
#include <zephyr/dt-bindings/input/input-event-codes.h> [cite: 183]
#include <behaviors.dtsi> [cite: 183]
#include <dt-bindings/zmk/bt.h> [cite: 183]
#include <dt-bindings/zmk/keys.h> [cite: 183]
#include <dt-bindings/zmk/outputs.h> [cite: 183]
#include <dt-bindings/zmk/pointing.h> [cite: 183]
#include <dt-bindings/zmk/rgb.h> [cite: 183]

/* Pointer and Scroll Tuning from AE baseline */
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; }; [cite: 183, 184]
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; }; [cite: 184]

&msc {
    acceleration-exponent = <1>; [cite: 184]
    time-to-max-speed-ms = <100>; [cite: 185]
    delay-ms = <0>; [cite: 185]
};

&mmv {
    time-to-max-speed-ms = <500>; [cite: 186]
    acceleration-exponent = <1>; [cite: 186]
    trigger-period-ms = <16>; [cite: 186]
};

&soft_off { hold-time-ms = <2000>; }; [cite: 186, 187]

/ {
    /* Behavior: Rotary encoder scroll logic from Jason */
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate"; [cite: 112, 113]
        #sensor-binding-cells = <0>; [cite: 113]
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>; [cite: 113]
        tap-ms = <100>; [cite: 113]
    };

    /* Behaviors: Home Row Mods (HRM) from Jason */
    behaviors {
        hml: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap"; [cite: 114, 115]
            label = "HML"; [cite: 115]
            #binding-cells = <2>; [cite: 115]
            flavor = "balanced"; [cite: 115]
            tapping-term-ms = <280>; [cite: 115]
            quick-tap-ms = <175>; [cite: 115]
            require-prior-idle-ms = <125>; [cite: 115]
            bindings = <&kp>, <&kp>; [cite: 116]
            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>; [cite: 116]
            hold-trigger-on-release; [cite: 117]
        };

        hmr: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap"; [cite: 117, 118]
            label = "HMR"; [cite: 118]
            #binding-cells = <2>; [cite: 118]
            flavor = "balanced"; [cite: 118]
            tapping-term-ms = <280>; [cite: 118]
            quick-tap-ms = <175>; [cite: 118]
            require-prior-idle-ms = <125>; [cite: 118]
            bindings = <&kp>, <&kp>; [cite: 119]
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>; [cite: 119]
            hold-trigger-on-release; [cite: 120]
        };

        hsl: left_shift_hrm {
            compatible = "zmk,behavior-hold-tap"; [cite: 120, 121]
            label = "HSL"; [cite: 121]
            #binding-cells = <2>; [cite: 121]
            flavor = "balanced"; [cite: 121]
            tapping-term-ms = <175>; [cite: 121]
            quick-tap-ms = <175>; [cite: 121]
            bindings = <&kp>, <&kp>; [cite: 121]
            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>; [cite: 122]
            hold-trigger-on-release; [cite: 123]
        };

        hsr: right_shift_hrm {
            compatible = "zmk,behavior-hold-tap"; [cite: 123, 124]
            label = "HSR"; [cite: 124]
            #binding-cells = <2>; [cite: 124]
            flavor = "balanced"; [cite: 124]
            tapping-term-ms = <175>; [cite: 124]
            quick-tap-ms = <175>; [cite: 124]
            bindings = <&kp>, <&kp>; [cite: 124]
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>; [cite: 125]
            hold-trigger-on-release; [cite: 126]
        };
    };

    /* Macros: Bracket and quote tools from Jason */
    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro"; [cite: 139]
            #binding-cells = <0>; [cite: 139]
            bindings = <&kp LPAR &kp RPAR &kp LEFT>; [cite: 139]
            label = "BRACKET_SOFT"; [cite: 139]
        };
        bracket_square: bracket_square {
            compatible = "zmk,behavior-macro"; [cite: 140]
            #binding-cells = <0>; [cite: 140]
            bindings = <&kp LBKT &kp RBKT &kp LEFT>; [cite: 141]
            label = "BRACKET_SQUARE"; [cite: 140]
        };
        bracket_sqiggly: bracket_sqiggly {
            compatible = "zmk,behavior-macro"; [cite: 142]
            #binding-cells = <0>; [cite: 142]
            bindings = <&kp LBRC &kp RBRC &kp LEFT>; [cite: 143]
            label = "BRACKET_SQIGGLY"; [cite: 142]
        };
        bracket_quote: bracket_quote {
            compatible = "zmk,behavior-macro"; [cite: 144]
            #binding-cells = <0>; [cite: 144]
            bindings = <&kp DQT &kp DQT &kp LEFT_ARROW>; [cite: 145]
            label = "BRACKET_QUOTE"; [cite: 144]
        };
        bracket_triangle: bracket_triangle {
            compatible = "zmk,behavior-macro"; [cite: 146]
            #binding-cells = <0>; [cite: 146]
            bindings = <&kp LT &kp GT &kp LEFT>; [cite: 147]
            label = "BRACKET_TRIANGLE"; [cite: 146]
        };
    };

    /* Combos from Jason */
    combos {
        compatible = "zmk,combos"; [cite: 127]
        soft_off_left { bindings = <&soft_off>; key-positions = <27 29 31>; }; [cite: 127, 128]
        soft_off_right { bindings = <&soft_off>; key-positions = <33 35 37>; }; [cite: 128, 129]
        reset_left { bindings = <&sys_reset>; key-positions = <14 16 18>; }; [cite: 129, 130]
        reset_right { bindings = <&sys_reset>; key-positions = <20 22 24>; }; [cite: 130, 131]
        bootloader_left { bindings = <&bootloader>; key-positions = <40 42 44>; }; [cite: 131, 132]
        bootloader_right { bindings = <&bootloader>; key-positions = <46 48 50>; }; [cite: 132, 133]
        bracket_soft { bindings = <&bracket_soft>; key-positions = <29 30>; layers = <1>; }; [cite: 133, 134]
        bracket_quote { bindings = <&bracket_quote>; key-positions = <34 35>; layers = <1>; }; [cite: 134, 135]
        minus { bindings = <&kp MINUS>; key-positions = <21 22>; }; [cite: 135, 136]
        equal { bindings = <&kp EQUAL>; key-positions = <22 23>; }; [cite: 136, 137]
        apostrophe { bindings = <&kp SQT>; key-positions = <49 50>; }; [cite: 137, 138]
    };

    /* Keymap Layers from Jason */
    keymap {
        compatible = "zmk,keymap"; [cite: 148]

        default {
            display-name = "default"; [cite: 154]
            bindings = <
&kp ESC           &kp N1       &kp N2       &kp N3        &kp N4  &kp N5            &kp UP_ARROW     &kp N6     &kp N7  &kp N8          &kp N9       &kp N0          &kp DEL [cite: 149, 150]
&kp TAB           &kp Q        &kp W        &kp E         &kp R   &kp T             &kp DOWN_ARROW   &kp Y      &kp U   &kp I           &kp O        &kp P           &kp BACKSPACE [cite: 150, 151]
&kp LEFT_CONTROL  &hml LGUI A  &hml LALT S  &hml LCTRL D  &kp F   &kp G             &kp LEFT_ARROW   &kp H      &kp J   &hmr RCTRL K    &hmr RALT L  &hmr RGUI SEMI  &kp ENTER [cite: 151]
&caps_word        &kp Z        &kp X        &kp C         &kp V   &kp B             &kp RIGHT_ARROW  &kp N      &kp M   &kp COMMA       &kp DOT      &kp FSLH        &tog 6 [cite: 151, 152]
&kp C_MUTE        &none        &none        &tog 2        &mo 1   &kp LEFT_SHIFT    &kp ENTER        &kp SPACE  &mo 3   &mo 4           &none        &none [cite: 152, 153]
            >;
            sensor-bindings = <&scroll_encoder>; [cite: 154]
        };

        num_symbol {
            bindings = <
&trans  &trans           &trans           &trans     &trans      &trans           &trans  &trans     &trans         &trans        &trans                &trans                 &trans [cite: 154, 155]
&trans  &kp EXCLAMATION  &kp AT_SIGN      &kp POUND  &kp DOLLAR  &kp PERCENT      &trans  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans [cite: 155]
&trans  &kp N1           &kp N2           &kp N3     &kp N4      &kp N5           &trans  &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &kp TILDE [cite: 155, 156]
&trans  &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp LBKT   &kp RBKT    &kp BACKSLASH    &trans  &kp PIPE   &kp MINUS      &kp UNDER     &kp EQUAL             &kp PLUS               &kp GRAVE [cite: 156, 157]
&trans  &trans           &trans           &trans     &trans      &trans           &trans  &trans     &trans         &trans        &trans                &trans [cite: 157, 158]
            >;
        };

        navigation {
            bindings = <
&trans  &trans            &trans          &trans         &trans     &trans           &trans  &trans  &trans    &trans    &trans     &trans    &trans [cite: 159]
&trans  &kp LA(F4)        &trans          &kp LC(LS(T))  &kp LC(T)  &kp LC(N)        &trans  &trans  &trans    &kp UP    &trans     &kp BSPC  &trans [cite: 159, 160]
&trans  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LALT       &kp TAB    &kp LS(LC(N))    &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL   &trans [cite: 160]
&trans  &kp LC(Z)         &kp LC(X)       &kp LC(C)      &kp LC(V)  &kp LC(Y)        &trans  &trans  &trans    &trans    &trans     &trans    &trans [cite: 160, 161]
&trans  &trans            &trans          &trans         &trans     &trans           &trans  &trans  &trans    &trans    &trans     &trans [cite: 161, 162]
            >;
        };

        numpad {
            bindings = <
&trans  &trans     &trans        &trans        &trans         &trans        &trans  &trans  &trans  &trans  &trans  &trans         &trans [cite: 163]
&trans  &trans     &kp DEL       &kp UP_ARROW  &kp BACKSPACE  &trans        &trans  &trans  &kp N7  &kp N8  &kp N9  &kp BACKSPACE  &trans [cite: 163, 164]
&trans  &trans     &kp LEFT      &kp DOWN      &kp RIGHT      &kp EQUAL     &trans  &trans  &kp N4  &kp N5  &kp N6  &trans         &trans [cite: 164]
&trans  &kp SLASH  &kp ASTERISK  &kp MINUS     &kp PLUS       &kp PERIOD    &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans         &trans [cite: 164, 165]
&trans  &trans     &trans        &trans        &trans         &trans        &trans  &trans  &trans  &trans  &trans  &trans [cite: 165]
            >;
        };

        function {
            bindings = <
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &trans   &trans  &trans  &trans  &trans   &trans [cite: 166]
&trans  &kp PAUSE_BREAK  &kp SCROLLLOCK  &trans  &kp PRINTSCREEN  &kp F11    &trans  &kp F12  &trans  &trans  &trans  &trans   &trans [cite: 166, 167]
&trans  &kp F1           &kp F2          &kp F3  &kp F4           &kp F5     &trans  &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans [cite: 167]
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &trans   &trans  &trans  &trans  &trans   &trans [cite: 167, 168]
&trans  &trans           &trans          &trans  &trans           &trans     &trans  &trans   &trans  &trans  &trans  &trans [cite: 168]
            >;
        };

        page_nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans         &trans    &trans   &trans  &trans [cite: 169]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans         &trans    &trans   &trans  &trans [cite: 169]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PAGE_UP  &kp PAGE_DOWN  &kp HOME  &kp END  &trans  &trans [cite: 169, 170]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans         &trans    &trans   &trans  &trans [cite: 170]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans         &trans    &trans   &trans [cite: 170, 171]
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans          &trans          &trans           &trans          &trans [cite: 172]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP    &trans [cite: 172, 173]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans [cite: 173]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans          &trans          &trans           &trans          &trans [cite: 173, 174]
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK  &mkp RCLK       &mkp MCLK       &trans           &trans [cite: 174]
            >;
        };

        system {
            bindings = <
&trans  &trans        &trans        &trans          &trans        &trans    &trans  &trans  &trans           &trans          &trans           &trans           &trans [cite: 175, 176]
&trans  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &bt BT_SEL 0  &trans    &trans  &trans  &trans           &trans          &trans           &trans           &trans [cite: 176]
&trans  &trans        &trans        &out OUT_USB    &out OUT_BLE  &trans    &trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans [cite: 176, 177]
&trans  &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR    &trans    &trans  &trans  &trans           &trans          &trans           &trans           &trans [cite: 177]
&trans  &trans        &trans        &trans          &trans        &trans    &trans  &trans  &trans           &trans          &trans           &trans [cite: 177, 178]
            >;
        };
    };

    /* Conditional Layers from Jason */
    conditional_layers {
        compatible = "zmk,conditional-layers"; [cite: 179]
        page_nav {
            if-layers = <1 2>; [cite: 180]
            then-layer = <5>; [cite: 180]
        };
        system_layer {
            if-layers = <1 3>; [cite: 181]
            then-layer = <7>; [cite: 182]
        };
    };
};
